	partition _Notifications = m
		mode: import
		source = ```
				let
				    Source = Sql.Database("busc6dxmchierdn6rby46laxoa-uxfhnidcfrcenh64rrzsoxti5q.database.fabric.microsoft.com", "sqldb_report_status-88b8b8ef-96ba-4860-bc12-a92f45ab72ce", [Query="
				    SELECT     
				    [Notification]    
				    ,[NotificationStatus]
				    ,[Link]  
				    FROM [dbo].[Notifications]
				    where [DatasetName]='" & P_ModelName & "'
				           and [Environment]='" & P_Env & "'
				             and [EndDate] is null"])
				in
				    Source
				```

