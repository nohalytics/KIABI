			,
			    __status= "Error", 
			
			"data:image/svg+xml;utf8," &
			"<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M17.4905 3.5C16.8504 2.88426 16.4028 2.52356 15.8739 2.30448C15.1388 2 14.3213 2 12.6863 2H11.3137C9.67871 2 8.8612 2 8.12612 2.30448C7.39104 2.60896 6.81298 3.18702 5.65685 4.34315L4.34315 5.65685C3.18702 6.81298 2.60896 7.39104 2.30448 8.12612C2 8.8612 2 9.67871 2 11.3137V12.6863C2 14.3213 2 15.1388 2.30448 15.8739C2.60896 16.609 3.18702 17.187 4.34315 18.3431L5.65685 19.6569C6.81298 20.813 7.39104 21.391 8.12612 21.6955C8.8612 22 9.67871 22 11.3137 22H12.6863C14.3213 22 15.1388 22 15.8739 21.6955C16.609 21.391 17.187 20.813 18.3431 19.6569L19.6569 18.3431C20.813 17.187 21.391 16.609 21.6955 15.8739C22 15.1388 22 14.3213 22 12.6863V11.3137C22 9.67871 22 8.8612 21.6955 8.12612C21.4754 7.59461 21.1122 7.1452 20.4909 6.5M9 15L12 12M12 12L15 9M12 12L9 9M12 12L15 15' stroke='#DB1527' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>",
			"data:image/svg+xml;utf8," &
			"<svg width='24' height='24' viewBox='0 0 24 24' fill='none' xmlns='http://www.w3.org/2000/svg'><path d='M17.5 3.64702C15.9221 2.60596 14.0318 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 10.3814 21.6154 8.85259 20.9327 7.5M12 16V11M12.5 8C12.5 8.27614 12.2761 8.5 12 8.5C11.7239 8.5 11.5 8.27614 11.5 8M12.5 8C12.5 7.72386 12.2761 7.5 12 7.5C11.7239 7.5 11.5 7.72386 11.5 8M12.5 8H11.5' stroke='black' stroke-opacity='0' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/></svg>"
			
			)
			```
		lineageTag: 99f465b8-c751-498c-86a6-7eee8d2568e0

	measure 'Page destination' = If(max(_Notifications[Notification]) <> blank(), "Message")
		lineageTag: 317f9848-ef76-4500-b138-12444ffe1557

	measure Link_ = max(_Notifications[Link])
		lineageTag: b705899b-e962-45d7-a649-bc1bc8315f65

