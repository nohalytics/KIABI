table _KPI
	lineageTag: 430bf9c1-e144-4af3-8228-56f99f9c0574

	measure WorkdpaceId =
			VAR _isFiltered = ISFILTERED ( 'Catalog - Dataset'[Workspace])
			VAR _distinctCount = DISTINCTCOUNT ('Catalog - Dataset'[WorkspaceId])
			RETURN
			    IF (
			      _isFiltered &&
			         _distinctCount = 1,
			        SELECTEDVALUE ('Catalog - Dataset'[WorkspaceId] ),
			        BLANK ()
			    )
		lineageTag: 93c82a2b-70f2-4575-8b08-9fa4084d93d0

